      "source": [
        "# RR Pressure Reliability & Auction Intelligence Dashboard\n",
        "\n",
        "This notebook launches the Streamlit dashboard for the result files produced by `RR_Pressure_Reliability_Auction_Colab.ipynb`.\n",
        "\n",
        "**Recommended sequence:** run the modelling notebook first in this workspace. It creates `rr_auction_outputs.zip`. Then run this launcher. If the results ZIP is not present, the dashboard uses its bundled sample output.\n",
        "\n",
        "The dashboard reports historical pressure-performance evidence. IPL 2027 availability, eligibility, RR squad fit and auction value remain unverified until separate data is added."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "id": "1d7c7572",
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "No fresh results ZIP found. The dashboard will use bundled samples until you upload one in the sidebar.\n",
            "Dashboard project: c:\\Users\\PAWAN\\Downloads\\RR_contest_GPT\\rr_auction_dashboard\n"
          ]
        }
      ],
      "source": [
        "# Prepare the dashboard package locally in VS Code.\n",
        "from pathlib import Path\n",
        "import zipfile, shutil\n",
        "\n",
        "# Run this notebook from the RR_contest_GPT workspace, or put the package ZIP\n",
        "# beside this notebook.\n",
        "workspace_dir = Path.cwd()\n",
        "dashboard_zip = workspace_dir / 'RR_Auction_Intelligence_Dashboard.zip'\n",
        "if not dashboard_zip.exists():\n",
        "    raise FileNotFoundError(\n",
        "        'Dashboard package not found. Place RR_Auction_Intelligence_Dashboard.zip '\n",
        "        f'beside this notebook in: {workspace_dir}'\n",
        "    )\n",
        "\n",
        "with zipfile.ZipFile(dashboard_zip) as zf:\n",
        "    zf.extractall(workspace_dir)\n",
        "\n",
        "project_dir = workspace_dir / 'rr_auction_dashboard'\n",
        "if not project_dir.exists():\n",
        "    # Some packages may use their ZIP filename or a package subfolder as the root.\n",
        "    candidates = [p.parent for p in workspace_dir.glob('**/app.py')]\n",
        "    project_dir = candidates[0] if candidates else project_dir\n",
        "if not (project_dir / 'app.py').exists():\n",
        "    raise FileNotFoundError('Dashboard app.py was not found inside the package.')\n",
        "\n",
        "# Prefer fresh outputs from the modelling notebook.\n",
        "fresh_results = workspace_dir / 'rr_auction_outputs.zip'\n",
        "if not fresh_results.exists():\n",
        "    fresh_results = workspace_dir / 'content' / 'rr_auction_outputs.zip'\n",
        "sample_results_dir = project_dir / 'sample_results'\n",
        "sample_results_dir.mkdir(parents=True, exist_ok=True)\n",
        "if fresh_results.exists():\n",
        "    shutil.copy2(fresh_results, sample_results_dir / 'rr_auction_outputs_initial_run.zip')\n",
        "    print('Using fresh results from the modelling notebook.')\n",
        "else:\n",
        "    print('No fresh results ZIP found. The dashboard will use bundled samples until you upload one in the sidebar.')\n",
        "\n",
        "print('Dashboard project:', project_dir)"
      ]
    },
