      "source": [
        "# Start Streamlit locally in VS Code.\n",
        "import time\n",
        "import webbrowser\n",
        "from urllib.request import urlopen\n",
        "\n",
        "app_path = project_dir / 'app.py'\n",
        "if not app_path.exists():\n",
        "    raise FileNotFoundError(f'Dashboard app not found: {app_path}')\n",
        "\n",
        "log_path = workspace_dir / 'rr_streamlit.log'\n",
        "venv_python = project_dir / '.venv' / 'Scripts' / 'python.exe'\n",
        "if not venv_python.exists():\n",
        "    raise FileNotFoundError('Dashboard virtual environment is missing. Run the dependency cell first.')\n",
        "\n",
        "with log_path.open('w', encoding='utf-8') as log_file:\n",
        "    proc = subprocess.Popen(\n",
        "        [str(venv_python), '-m', 'streamlit', 'run', str(app_path),\n*** End Patch
        "         '--server.port=8501', '--server.address=127.0.0.1',\n",
        "         '--server.headless=true', '--browser.gatherUsageStats=false'],\n",
        "        cwd=str(project_dir), stdout=log_file, stderr=subprocess.STDOUT\n",
        "    )\n",
        "\n",
        "url = 'http://127.0.0.1:8501'\n",
        "started = False\n",
        "for _ in range(15):\n",
        "    if proc.poll() is not None:\n",
        "        break\n",
        "    try:\n",
        "        with urlopen(url, timeout=1) as response:\n",
        "            if response.status == 200:\n",
        "                started = True\n",
        "                break\n",
        "    except Exception:\n",
        "        time.sleep(1)\n",
        "\n",
        "if not started:\n",
        "    log_text = log_path.read_text(encoding='utf-8', errors='replace')\n",
        "    raise RuntimeError(\n",
        "        'Streamlit did not start.\\n\\n' +\n",
        "        (log_text if log_text else 'Streamlit did not start; see rr_streamlit.log.')\n",
        "    )\n",
        "\n",
        "print(f'Streamlit is running at {url}')\n",
        "webbrowser.open(url)"
      ]
    },
    {
      "cell_type": "markdown",
